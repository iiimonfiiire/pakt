# Copy to .env, then run: chmod 600 .env
# Set at least one key. PAKT tries the providers in order and skips any without a key.

# Google AI Studio key. The free tier works. Google may use free-tier inputs to improve its models,
# so do not send confidential or employer documents through a free-tier key.
GEMINI_API_KEY=your-api-key-here

# Groq key. PAKT falls back to Groq when Gemini is rate limited, down, or times out.
GROQ_API_KEY=your-api-key-here

# Anthropic key. Optional when the other providers cover you.
ANTHROPIC_API_KEY=your-api-key-here

# Optional: the provider order, comma-separated. Overrides [providers] order in config.toml.
# PAKT_PROVIDERS=gemini,groq,anthropic

# Optional: one model per provider and role. Roles: GENERATOR, JUDGE, REVIEW.
# PAKT_GEMINI_GENERATOR_MODEL=gemini-3.6-flash
# PAKT_GEMINI_JUDGE_MODEL=gemini-3.6-flash
# PAKT_GEMINI_REVIEW_MODEL=gemini-3.6-flash
# PAKT_GROQ_GENERATOR_MODEL=openai/gpt-oss-120b
# PAKT_GROQ_JUDGE_MODEL=openai/gpt-oss-120b
# PAKT_GROQ_REVIEW_MODEL=openai/gpt-oss-120b
# PAKT_ANTHROPIC_GENERATOR_MODEL=claude-haiku-4-5-20251001
# PAKT_ANTHROPIC_JUDGE_MODEL=claude-sonnet-5-5
# PAKT_ANTHROPIC_REVIEW_MODEL=claude-sonnet-5-5

# Older names for the Anthropic models. They still work, and they apply to Anthropic only.
# PAKT_GENERATOR_MODEL=claude-haiku-4-5-20251001
# PAKT_JUDGE_MODEL=claude-sonnet-5-5
# PAKT_REVIEW_MODEL=claude-sonnet-5-5

# Optional: log detail on stderr. INFO shows which provider served each call. WARNING shows only fallbacks.
# PAKT_LOG_LEVEL=INFO

# Optional: point the pakt CLI at a PAKT checkout when you run it from elsewhere
# PAKT_ROOT=/path/to/pakt
